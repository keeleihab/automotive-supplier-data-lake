					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "       SELECT TableName, CONVERT(VARCHAR(27), LastWatermark, 126) AS LastWatermark\n       FROM etl.ControlTable\n       WHERE IsActive = 1\n       ORDER BY TableName",
