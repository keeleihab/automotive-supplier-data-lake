{
	"name": "pl_ingest_plant_de",
	"properties": {
		"activities": [
			{
				"name": "CopyLandingToBronze",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "BinarySource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": false,
							"wildcardFolderPath": "plant_de",
							"wildcardFileName": "*.csv",
							"deleteFilesAfterCompletion": true
						},
						"formatSettings": {
							"type": "BinaryReadSettings"
						}
					},
					"sink": {
						"type": "BinarySink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings",
							"copyBehavior": "PreserveHierarchy"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ds_landing_binary",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_bronze_binary",
						"type": "DatasetReference",
						"parameters": {
							"FolderPath": {
								"value": "plant_de/@{formatDateTime(utcNow(),'yyyy/MM/dd')}",
								"type": "Expression"
							}
						}
					}
				]
			}
		],
		"annotations": []
	}
}